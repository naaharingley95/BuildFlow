@model BuildFlow.Models.ErrorViewModel
@{
    ViewData["Title"] = "System Error";
}

<div style="max-width:650px;margin:50px auto;text-align:center;">
    <div style="font-size:56px;color:#ff6b6b;margin-bottom:16px;">
        <i class="fa fa-triangle-exclamation"></i>
    </div>
    <h1 style="font-size:26px;margin-bottom:8px;">An Unexpected Error Occurred</h1>
    <p class="text-muted mb-6">Something went wrong while processing your request. The issue has been logged for review.</p>

    @if (Model?.ShowRequestId == true)
    {
        <div class="card mb-6" style="text-align:left;display:inline-block;padding:12px 20px;">
            <span class="text-muted text-sm">Request Trace ID:</span>
            <code style="color:var(--accent2);margin-left:8px;">@Model.RequestId</code>
        </div>
    }

    <div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
            <i class="fa fa-gauge-high"></i> Return to Dashboard
        </a>
    </div>
</div>

