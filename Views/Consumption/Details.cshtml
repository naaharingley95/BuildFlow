@model BuildFlow.Models.MaterialConsumption
@using BuildFlow.Models
@{ ViewData["Title"] = "Consumption Record Details"; }

<div class="page-header">
    <div>
        <div class="flex-gap mb-4">
            <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="fa fa-arrow-left"></i> Back</a>
            <span class="badge badge-yellow"><i class="fa fa-fire"></i> Consumption</span>
        </div>
        <h1>@Model.Material?.Name — @Model.ConsumedQuantity.ToString("N2") @Model.Material?.Unit</h1>
        <p class="text-muted">Recorded on @Model.ConsumptionDate.ToString("dd MMM yyyy") by @Model.RecordedBy?.FullName</p>
    </div>
</div>

<div class="card" style="max-width:800px;">
    <div class="card-title mb-4">Usage Information</div>
    <div class="detail-grid">
        <div class="detail-item"><div class="label">Site</div><div class="value">@Model.Site?.SiteName</div></div>
        <div class="detail-item"><div class="label">Material</div><div class="value">@Model.Material?.Name</div></div>
        <div class="detail-item"><div class="label">Category</div><div class="value">@Model.Material?.Category?.Name</div></div>
        <div class="detail-item"><div class="label">Consumed Qty</div><div class="value" style="color:var(--accent2);font-size:16px;">@Model.ConsumedQuantity.ToString("N2") @Model.Material?.Unit</div></div>
        <div class="detail-item"><div class="label">Wastage Qty</div><div class="value" style="color:@(Model.WastageQuantity > 0 ? "#ff6b6b" : "inherit")">@Model.WastageQuantity.ToString("N2") @Model.Material?.Unit</div></div>
        <div class="detail-item"><div class="label">Work Activity</div><div class="value">@Model.WorkActivity</div></div>
        <div class="detail-item"><div class="label">Consumption Date</div><div class="value">@Model.ConsumptionDate.ToString("dd MMM yyyy")</div></div>
        <div class="detail-item"><div class="label">Recorded By</div><div class="value">@Model.RecordedBy?.FullName</div></div>
        <div class="detail-item"><div class="label">Timestamp (UTC)</div><div class="value text-sm text-muted">@Model.CreatedAtUtc.ToString("dd MMM yyyy HH:mm")</div></div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
    {
        <hr />
        <div class="detail-item">
            <div class="label">Remarks</div>
            <div style="margin-top:4px;color:var(--text-muted)">@Model.Remarks</div>
        </div>
    }
</div>
