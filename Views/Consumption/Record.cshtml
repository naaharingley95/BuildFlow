@model BuildFlow.Models.MaterialConsumption
@using BuildFlow.Models
@{ ViewData["Title"] = "Record Consumption"; }

<div class="page-header">
    <div>
        <a asp-action="Index" class="btn btn-secondary btn-sm mb-4"><i class="fa fa-arrow-left"></i> Back</a>
        <h1>Record Material Consumption</h1>
        <p class="text-muted">Deduct materials consumed in on-site construction work from available inventory.</p>
    </div>
</div>

<form method="post" asp-action="Record">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card mb-6" style="max-width:800px;">
        <div class="grid-2 mb-4">
            <div class="form-group">
                <label class="form-label">Construction Site *</label>
                <select asp-for="SiteId" class="form-control" required>
                    <option value="">Select site...</option>
                    @foreach (var s in ViewBag.Sites as List<ConstructionSite> ?? new())
                    {
                        <option value="@s.Id">@s.SiteName</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Material *</label>
                <select asp-for="MaterialId" class="form-control" required>
                    <option value="">Select material...</option>
                    @foreach (var m in ViewBag.Materials as List<Material> ?? new())
                    {
                        <option value="@m.Id">@m.Name (@m.Unit)</option>
                    }
                </select>
            </div>
        </div>

        <div class="grid-3 mb-4">
            <div class="form-group">
                <label class="form-label">Consumption Date *</label>
                <input asp-for="ConsumptionDate" type="date" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="form-label">Quantity Consumed *</label>
                <input asp-for="ConsumedQuantity" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" required />
            </div>

            <div class="form-group">
                <label class="form-label">Wastage / Scrap Qty</label>
                <input asp-for="WastageQuantity" type="number" step="0.01" min="0" class="form-control" value="0.00" />
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Work Activity / Purpose *</label>
            <input asp-for="WorkActivity" class="form-control" placeholder="e.g. 5th floor slab casting, plumbing line installation..." required />
        </div>

        <div class="form-group">
            <label class="form-label">Remarks</label>
            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Additional observations, location details..."></textarea>
        </div>

        <div class="flex-gap mt-4">
            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Save & Deduct From Stock</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </div>
</form>
