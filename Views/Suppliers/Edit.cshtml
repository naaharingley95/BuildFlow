@model BuildFlow.Models.Supplier
@using BuildFlow.Models
@{ ViewData["Title"] = $"Edit {Model.CompanyName}"; }

<div class="page-header">
    <div>
        <a asp-action="Index" class="btn btn-secondary btn-sm mb-4"><i class="fa fa-arrow-left"></i> Back</a>
        <h1>Edit Supplier: @Model.CompanyName</h1>
    </div>
</div>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatedAtUtc" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card mb-6" style="max-width:800px;">
        <div class="grid-2 mb-4">
            <div class="form-group">
                <label class="form-label">Company Name *</label>
                <input asp-for="CompanyName" class="form-control" required />
                <span asp-validation-for="CompanyName" class="text-sm" style="color:#ff6b6b"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Contact Person *</label>
                <input asp-for="ContactPerson" class="form-control" required />
                <span asp-validation-for="ContactPerson" class="text-sm" style="color:#ff6b6b"></span>
            </div>
        </div>

        <div class="grid-2 mb-4">
            <div class="form-group">
                <label class="form-label">Phone Number *</label>
                <input asp-for="PhoneNumber" class="form-control" required />
                <span asp-validation-for="PhoneNumber" class="text-sm" style="color:#ff6b6b"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Email Address *</label>
                <input asp-for="Email" type="email" class="form-control" required />
                <span asp-validation-for="Email" class="text-sm" style="color:#ff6b6b"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Office / Plant Address</label>
            <input asp-for="Address" class="form-control" />
        </div>

        <div class="form-group">
            <label class="form-label">Material Categories Supplied</label>
            <input asp-for="MaterialCategoriesSupplied" class="form-control" />
        </div>

        <div class="grid-2 mb-4">
            <div class="form-group">
                <label class="form-label">Payment Terms</label>
                <select asp-for="PaymentTerms" class="form-control">
                    @foreach (var pt in Enum.GetValues<PaymentTerms>())
                    {
                        <option value="@pt">@pt</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Supplier Status</label>
                <select asp-for="Status" class="form-control">
                    @foreach (var st in Enum.GetValues<SupplierStatus>())
                    {
                        <option value="@st">@st</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Notes</label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        </div>

        <div class="flex-gap">
            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
        </div>
    </div>
</form>
