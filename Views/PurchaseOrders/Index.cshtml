@model List<BuildFlow.Models.PurchaseOrder>
@using BuildFlow.Models
@{ ViewData["Title"] = "Purchase Orders"; }

<div class="page-header">
    <h1><i class="fa fa-file-invoice" style="color:var(--accent)"></i> Purchase Orders</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="fa fa-plus"></i> New PO</a>
</div>

<div class="filter-bar mb-4">
    <form method="get" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
        <div>
            <label class="form-label">Site</label>
            <select name="siteId" class="form-control">
                <option value="">All Sites</option>
                @foreach (var s in ViewBag.Sites as List<ConstructionSite> ?? new())
                {
                    <option value="@s.Id" selected="@(ViewBag.SiteId?.ToString() == s.Id.ToString())">@s.SiteName</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Status</label>
            <select name="status" class="form-control">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<PurchaseOrderStatus>())
                {
                    <option value="@s" selected="@(ViewBag.Status?.ToString() == s.ToString())">@s</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-secondary"><i class="fa fa-filter"></i> Filter</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </form>
</div>

<div class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>PO Number</th><th>Site</th><th>Supplier</th><th>Order Date</th><th>Expected Delivery</th><th>Amount</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var po in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@po.Id" style="color:var(--accent);text-decoration:none;font-weight:600;">@po.OrderNumber</a></td>
                    <td>@po.Site?.SiteName</td>
                    <td>@po.Supplier?.CompanyName</td>
                    <td class="text-sm text-muted">@po.OrderDate.ToString("dd MMM yyyy")</td>
                    <td class="text-sm text-muted">@po.ExpectedDeliveryDate.ToString("dd MMM yyyy")</td>
                    <td class="fw-600">₹@po.TotalAmount.ToString("N2")</td>
                    <td><partial name="_StatusBadge" model="@po.Status.ToString()" /></td>
                    <td><a asp-action="Details" asp-route-id="@po.Id" class="btn btn-secondary btn-sm">View</a></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8" style="text-align:center;padding:32px;color:var(--text-muted);">No purchase orders found</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
