@model List<BuildFlow.Services.MaterialRequestReportRow>
@using BuildFlow.Models
@{ ViewData["Title"] = "Material Requests Audit"; }

<div class="page-header">
    <div>
        <a asp-action="Index" class="btn btn-secondary btn-sm mb-4"><i class="fa fa-arrow-left"></i> All Reports</a>
        <h1><i class="fa fa-list-check" style="color:var(--accent)"></i> Material Requests Audit Report</h1>
    </div>
    <div class="flex-gap">
        <a asp-action="ExportRequestsCsv" asp-route-siteId="@ViewBag.SiteId" asp-route-from="@(ViewBag.From != null ? ((DateTime)ViewBag.From).ToString("yyyy-MM-dd") : "")" asp-route-to="@(ViewBag.To != null ? ((DateTime)ViewBag.To).ToString("yyyy-MM-dd") : "")" class="btn btn-secondary"><i class="fa fa-file-csv"></i> Export CSV</a>
        <button onclick="window.print()" class="btn btn-secondary"><i class="fa fa-print"></i> Print</button>
    </div>
</div>

<div class="filter-bar mb-4">
    <form method="get" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
        <div>
            <label class="form-label">Site</label>
            <select name="siteId" class="form-control">
                <option value="">All Sites</option>
                @foreach (var s in ViewBag.Sites as List<ConstructionSite> ?? new())
                {
                    <option value="@s.Id" selected="@(ViewBag.SiteId?.ToString() == s.Id.ToString())">@s.SiteName</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">From Date</label>
            <input type="date" name="from" value="@(ViewBag.From != null ? ((DateTime)ViewBag.From).ToString("yyyy-MM-dd") : "")" class="form-control" />
        </div>
        <div>
            <label class="form-label">To Date</label>
            <input type="date" name="to" value="@(ViewBag.To != null ? ((DateTime)ViewBag.To).ToString("yyyy-MM-dd") : "")" class="form-control" />
        </div>
        <button type="submit" class="btn btn-secondary"><i class="fa fa-filter"></i> Filter</button>
        <a asp-action="Requests" class="btn btn-secondary">Clear</a>
    </form>
</div>

<div class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Request #</th>
                    <th>Site</th>
                    <th>Requested By</th>
                    <th>Date</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Items</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>
                        <a asp-controller="MaterialRequests" asp-action="Index" style="color:var(--accent);text-decoration:none;font-weight:600;">
                            @r.RequestNumber
                        </a>
                    </td>
                    <td>@r.SiteName</td>
                    <td class="text-sm">@r.RequestedBy</td>
                    <td class="text-sm text-muted">@r.RequestDate.ToString("dd MMM yyyy")</td>
                    <td><partial name="_PriorityBadge" model="@r.Priority.ToString()" /></td>
                    <td><partial name="_StatusBadge" model="@r.Status.ToString()" /></td>
                    <td class="text-muted">@r.ItemCount items</td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" style="text-align:center;padding:32px;color:var(--text-muted);">No requests recorded for selected period</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
