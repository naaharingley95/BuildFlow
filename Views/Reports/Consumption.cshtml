@model List<BuildFlow.Services.ConsumptionReportRow>
@using BuildFlow.Models
@{ ViewData["Title"] = "Consumption Report"; }

<div class="page-header">
    <div>
        <a asp-action="Index" class="btn btn-secondary btn-sm mb-4"><i class="fa fa-arrow-left"></i> All Reports</a>
        <h1><i class="fa fa-chart-line" style="color:var(--accent)"></i> Material Consumption Report</h1>
    </div>
    <div class="flex-gap">
        <a asp-action="ExportConsumptionCsv" asp-route-siteId="@ViewBag.SiteId" asp-route-from="@(ViewBag.From != null ? ((DateTime)ViewBag.From).ToString("yyyy-MM-dd") : "")" asp-route-to="@(ViewBag.To != null ? ((DateTime)ViewBag.To).ToString("yyyy-MM-dd") : "")" class="btn btn-secondary"><i class="fa fa-file-csv"></i> Export CSV</a>
        <button onclick="window.print()" class="btn btn-secondary"><i class="fa fa-print"></i> Print</button>
    </div>
</div>

<div class="filter-bar mb-4">
    <form method="get" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
        <div>
            <label class="form-label">Site</label>
            <select name="siteId" class="form-control">
                <option value="">All Sites</option>
                @foreach (var s in ViewBag.Sites as List<ConstructionSite> ?? new())
                {
                    <option value="@s.Id" selected="@(ViewBag.SiteId?.ToString() == s.Id.ToString())">@s.SiteName</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">From Date</label>
            <input type="date" name="from" value="@(ViewBag.From != null ? ((DateTime)ViewBag.From).ToString("yyyy-MM-dd") : "")" class="form-control" />
        </div>
        <div>
            <label class="form-label">To Date</label>
            <input type="date" name="to" value="@(ViewBag.To != null ? ((DateTime)ViewBag.To).ToString("yyyy-MM-dd") : "")" class="form-control" />
        </div>
        <button type="submit" class="btn btn-secondary"><i class="fa fa-filter"></i> Filter</button>
        <a asp-action="Consumption" class="btn btn-secondary">Clear</a>
    </form>
</div>

<div class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Site</th>
                    <th>Material</th>
                    <th>Work Activity</th>
                    <th>Consumed Quantity</th>
                    <th>Wastage Quantity</th>
                    <th>Unit</th>
                    <th>Recorded By</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td class="text-sm">@r.Date.ToString("dd MMM yyyy")</td>
                    <td>@r.SiteName</td>
                    <td class="fw-600">@r.MaterialName</td>
                    <td class="text-muted text-sm">@r.WorkActivity</td>
                    <td style="font-weight:600;color:var(--accent2);">@r.ConsumedQty.ToString("N2")</td>
                    <td style="color:@(r.WastageQty > 0 ? "#ff6b6b" : "inherit")">@r.WastageQty.ToString("N2")</td>
                    <td class="text-muted">@r.Unit</td>
                    <td class="text-muted text-sm">@r.RecordedBy</td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8" style="text-align:center;padding:32px;color:var(--text-muted);">No consumption data recorded for selected period</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
