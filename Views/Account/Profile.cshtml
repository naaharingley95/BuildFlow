@model BuildFlow.Models.ApplicationUser
@{ ViewData["Title"] = "User Profile"; }

<div class="page-header">
    <h1><i class="fa fa-user-circle" style="color:var(--accent)"></i> My Profile</h1>
</div>

<div class="grid-2 mb-6">
    <div class="card">
        <div class="card-title mb-4">Account Information</div>
        <div class="detail-grid mb-4">
            <div class="detail-item"><div class="label">Full Name</div><div class="value">@Model.FullName</div></div>
            <div class="detail-item"><div class="label">Email Address</div><div class="value">@Model.Email</div></div>
            <div class="detail-item"><div class="label">Username</div><div class="value">@Model.UserName</div></div>
            <div class="detail-item"><div class="label">Status</div><div class="value">@(Model.IsActive ? "Active" : "Inactive")</div></div>
            <div class="detail-item"><div class="label">Member Since</div><div class="value text-sm text-muted">@Model.CreatedAtUtc.ToString("dd MMM yyyy")</div></div>
            <div class="detail-item"><div class="label">Last Sign In</div><div class="value text-sm text-muted">@(Model.LastLoginUtc.HasValue ? Model.LastLoginUtc.Value.ToString("dd MMM yyyy HH:mm") : "—")</div></div>
        </div>
    </div>

    <div class="card">
        <div class="card-title mb-4"><i class="fa fa-key" style="color:var(--accent4)"></i> Change Password</div>
        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Current Password *</label>
                <input type="password" name="CurrentPassword" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="form-label">New Password * (Min 8 chars, uppercase, lowercase, digit, special)</label>
                <input type="password" name="NewPassword" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="form-label">Confirm New Password *</label>
                <input type="password" name="ConfirmPassword" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-primary"><i class="fa fa-lock"></i> Update Password</button>
        </form>
    </div>
</div>
