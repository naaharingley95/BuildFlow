@{ ViewData["Title"] = "Access Denied"; }

<div style="max-width:600px;margin:60px auto;text-align:center;">
    <div style="font-size:56px;color:#ff6b6b;margin-bottom:16px;">
        <i class="fa fa-shield-halved"></i>
    </div>
    <h1 style="font-size:28px;margin-bottom:8px;">Access Denied</h1>
    <p class="text-muted mb-6">You do not have administrative or role-level permissions to access this feature or perform this action.</p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
        <i class="fa fa-arrow-left"></i> Return to Dashboard
    </a>
</div>
