@model BuildFlow.Models.ConstructionSite
@using BuildFlow.Models
@{ ViewData["Title"] = "New Construction Site"; }

<div class="page-header">
    <div>
        <a asp-action="Index" class="btn btn-secondary btn-sm mb-4"><i class="fa fa-arrow-left"></i> Back</a>
        <h1>Create Construction Site</h1>
    </div>
</div>

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card mb-6" style="max-width:800px;">
        <div class="form-group">
            <label class="form-label">Site Name *</label>
            <input asp-for="SiteName" class="form-control" placeholder="e.g. Skyline Towers Phase 2" required />
            <span asp-validation-for="SiteName" class="text-sm" style="color:#ff6b6b"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Location / Address *</label>
            <input asp-for="Location" class="form-control" placeholder="e.g. Sector 14, Hinjewadi, Pune" required />
            <span asp-validation-for="Location" class="text-sm" style="color:#ff6b6b"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Project Description</label>
            <textarea asp-for="ProjectDescription" class="form-control" rows="3" placeholder="Overview of site scope, building type, units..."></textarea>
        </div>

        <div class="grid-3 mb-4">
            <div class="form-group">
                <label class="form-label">Start Date *</label>
                <input asp-for="StartDate" type="date" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="form-label">Expected Completion</label>
                <input asp-for="ExpectedCompletionDate" type="date" class="form-control" />
            </div>

            <div class="form-group">
                <label class="form-label">Project Status</label>
                <select asp-for="Status" class="form-control">
                    @foreach (var st in Enum.GetValues<SiteStatus>())
                    {
                        <option value="@st">@st</option>
                    }
                </select>
            </div>
        </div>

        <div class="flex-gap">
            <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Create Site</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </div>
</form>
