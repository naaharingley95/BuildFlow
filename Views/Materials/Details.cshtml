@model BuildFlow.Models.Material
@using BuildFlow.Models
@{ ViewData["Title"] = Model.Name; }

<div class="page-header">
    <div>
        <div class="flex-gap mb-4">
            <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="fa fa-arrow-left"></i> Back to Materials</a>
            @if (Model.IsActive)
            {
                <span class="badge badge-green">Active</span>
            }
            else
            {
                <span class="badge badge-gray">Inactive</span>
            }
        </div>
        <h1>@Model.Name</h1>
        <p class="text-muted">Category: @(Model.Category?.Name ?? "Uncategorised") &bull; Unit: @Model.Unit</p>
    </div>
    <div class="flex-gap">
        @if (User.IsInRole("Admin") || User.IsInRole("Administrator") || User.IsInRole("Procurement") || User.IsInRole("ProcurementManager"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="fa fa-pen"></i> Edit</a>
        }
        <a asp-controller="MaterialRequests" asp-action="Create" class="btn btn-primary"><i class="fa fa-plus"></i> Request Material</a>
    </div>
</div>

<div class="card mb-6" style="max-width:800px;">
    <div class="card-title mb-4">Material Specifications</div>
    <div class="detail-grid">
        <div class="detail-item"><div class="label">Material Name</div><div class="value">@Model.Name</div></div>
        <div class="detail-item"><div class="label">Category</div><div class="value">@(Model.Category?.Name ?? "None")</div></div>
        <div class="detail-item"><div class="label">Unit of Measure</div><div class="value">@Model.Unit</div></div>
        <div class="detail-item"><div class="label">Benchmark Unit Price</div><div class="value" style="color:var(--accent2);font-weight:700;">₹@Model.UnitPrice.ToString("N2")</div></div>
        <div class="detail-item"><div class="label">Default Min Stock</div><div class="value">@Model.MinimumStockLevel.ToString("N2")</div></div>
        <div class="detail-item"><div class="label">Created Date</div><div class="value text-sm text-muted">@Model.CreatedAtUtc.ToString("dd MMM yyyy")</div></div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <hr />
        <div class="detail-item">
            <div class="label">Description / Technical Notes</div>
            <div style="margin-top:4px;color:var(--text-muted)">@Model.Description</div>
        </div>
    }
</div>
