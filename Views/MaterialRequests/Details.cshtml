@model BuildFlow.Models.MaterialRequest
@using BuildFlow.Models
@{ ViewData["Title"] = $"Request {Model.RequestNumber}"; }

<div class="page-header">
    <div>
        <div class="flex-gap mb-4">
            <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="fa fa-arrow-left"></i> Back</a>
            <partial name="_StatusBadge" model="@Model.Status.ToString()" />
            <partial name="_PriorityBadge" model="@Model.Priority.ToString()" />
        </div>
        <h1>@Model.RequestNumber</h1>
    </div>
    <div class="flex-gap">
        @if (Model.Status == RequestStatus.Draft)
        {
            <form asp-action="Submit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button class="btn btn-primary"><i class="fa fa-paper-plane"></i> Submit for Approval</button>
            </form>
        }
        @if (Model.Status == RequestStatus.Approved)
        {
            <a asp-controller="PurchaseOrders" asp-action="Create" asp-route-materialRequestId="@Model.Id" class="btn btn-success">
                <i class="fa fa-file-invoice"></i> Create Purchase Order
            </a>
        }
    </div>
</div>

<div class="grid-2 mb-6">
    <div class="card">
        <div class="card-title mb-4">Request Details</div>
        <div class="detail-grid">
            <div class="detail-item"><div class="label">Site</div><div class="value">@Model.Site?.SiteName</div></div>
            <div class="detail-item"><div class="label">Requested By</div><div class="value">@Model.RequestedBy?.FullName</div></div>
            <div class="detail-item"><div class="label">Request Date</div><div class="value">@Model.RequestDate.ToString("dd MMM yyyy")</div></div>
            <div class="detail-item"><div class="label">Required By</div><div class="value">@Model.RequiredByDate.ToString("dd MMM yyyy")</div></div>
            <div class="detail-item"><div class="label">Priority</div><div class="value">@Model.Priority</div></div>
            <div class="detail-item"><div class="label">Status</div><div class="value">@Model.Status</div></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.ReasonForRequest))
        {
            <hr />
            <div class="detail-item"><div class="label">Reason for Request</div><div style="margin-top:4px;color:var(--text-muted);">@Model.ReasonForRequest</div></div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Remarks))
        {
            <hr />
            <div class="detail-item"><div class="label">Remarks</div><div style="margin-top:4px;color:var(--text-muted);">@Model.Remarks</div></div>
        }
    </div>

    @if (Model.Status == RequestStatus.Submitted && User.IsInRole("Admin") || User.IsInRole("Procurement"))
    {
        <div class="card">
            <div class="card-title mb-4" style="color:#ff6b6b;">Approval Actions</div>
            <form asp-action="Approve" asp-route-id="@Model.Id" method="post" id="approve-form">
                @Html.AntiForgeryToken()
                @foreach (var item in Model.Items)
                {
                    <div style="display:flex;gap:10px;align-items:center;margin-bottom:10px;">
                        <span style="flex:1;font-size:13px;">@item.Material?.Name</span>
                        <span class="text-muted text-sm">Req: @item.RequestedQuantity</span>
                        <input type="hidden" name="itemIds" value="@item.Id" />
                        <input type="number" name="approvedQtys" value="@item.RequestedQuantity" min="0" step="0.01" class="form-control" style="width:100px;" />
                    </div>
                }
                <div class="form-group">
                    <label class="form-label">Remarks</label>
                    <input type="text" name="remarks" class="form-control" placeholder="Optional remarks..." />
                </div>
                <div class="flex-gap">
                    <button type="submit" class="btn btn-success"><i class="fa fa-check"></i> Approve</button>
                    <button type="button" class="btn btn-danger" onclick="document.getElementById('reject-form').style.display='block';this.parentElement.parentElement.style.display='none'">
                        <i class="fa fa-xmark"></i> Reject
                    </button>
                </div>
            </form>
            <form asp-action="Reject" asp-route-id="@Model.Id" method="post" id="reject-form" style="display:none">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="form-label">Rejection Reason *</label>
                    <input type="text" name="reason" class="form-control" required placeholder="Reason for rejection..." />
                </div>
                <div class="flex-gap">
                    <button type="submit" class="btn btn-danger"><i class="fa fa-xmark"></i> Confirm Reject</button>
                    <button type="button" class="btn btn-secondary" onclick="this.parentElement.parentElement.style.display='none';document.getElementById('approve-form').style.display='block'">Cancel</button>
                </div>
            </form>
        </div>
    }
</div>

<div class="card mb-6">
    <div class="card-title mb-4">Requested Items</div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Material</th><th>Category</th><th>Unit</th><th>Requested Qty</th><th>Approved Qty</th><th>Purpose</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="fw-600">@item.Material?.Name</td>
                    <td class="text-muted">@item.Material?.Category?.Name</td>
                    <td class="text-muted">@item.Material?.Unit</td>
                    <td>@item.RequestedQuantity.ToString("N2")</td>
                    <td>@(item.ApprovedQuantity > 0 ? item.ApprovedQuantity.ToString("N2") : "-")</td>
                    <td class="text-muted">@item.Purpose</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.ApprovalHistories.Any())
{
    <div class="card">
        <div class="card-title mb-4">Approval History</div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Action</th><th>By</th><th>From</th><th>To</th><th>Remarks</th><th>Date</th></tr></thead>
                <tbody>
                @foreach (var h in Model.ApprovalHistories.OrderBy(x => x.ActionDateUtc))
                {
                    <tr>
                        <td class="fw-600">@h.Action</td>
                        <td>@h.ActionByUser?.FullName</td>
                        <td><partial name="_StatusBadge" model="@h.FromStatus.ToString()" /></td>
                        <td><partial name="_StatusBadge" model="@h.ToStatus.ToString()" /></td>
                        <td class="text-muted">@h.Remarks</td>
                        <td class="text-sm text-muted">@h.ActionDateUtc.ToString("dd MMM yyyy HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
